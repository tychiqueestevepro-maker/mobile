    "lib": ["deno.window", "dom", "dom.iterable", "esnext"],
    "strict": true
  },
  "imports": {
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.57.4",
    "@apple/app-store-server-library": "npm:@apple/app-store-server-library@3.1.0",
    "@std/assert": "jsr:@std/assert@1.0.14"
