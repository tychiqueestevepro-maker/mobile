# Public Supabase values are also configured by the iOS app. All values below
# remain server-side Edge Function secrets.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# deterministic (default) or openai
PARSER_MODE=deterministic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

INTERNAL_API_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-different-long-random-secret
APP_STORE_WEBHOOK_SECRET=
DELIVERY_WEBHOOK_SECRET=

# StoreKit signed-data verification. Use xcode only for local StoreKit testing;
# sandbox and production verify the Apple certificate chain and fail closed.
APP_ENVIRONMENT=development
STOREKIT_ENVIRONMENT=xcode
APPLE_BUNDLE_ID=com.tychi.mobile.needs
APPLE_APP_ID=
# JSON array of base64 DER certificates downloaded from Apple PKI.
APPLE_ROOT_CA_CERTIFICATES_BASE64=[]
APPLE_ENABLE_ONLINE_CHECKS=true

# mock (default) or apns
PUSH_PROVIDER=mock
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=com.tychi.mobile.needs
APNS_ENVIRONMENT=sandbox

# mock is the only V1 implementation; the abstraction deliberately keeps PSP
# credentials server-side when a production adapter is added.
PAYMENT_PROVIDER=mock
RETAIL_PROVIDER=mock
DELIVERY_PROVIDER=mock
